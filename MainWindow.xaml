<Window x:Class="PixelAutoRace.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pixel Auto Race" Height="820" Width="1360" MinHeight="700" MinWidth="1050"
        WindowStartupLocation="CenterScreen" Background="#0B1020" Foreground="#F7F4EA"
        FontFamily="Consolas" FontSize="14" KeyDown="Window_KeyDown">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#151D32" />
        <SolidColorBrush x:Key="PanelLightBrush" Color="#202B45" />
        <SolidColorBrush x:Key="MutedBrush" Color="#8994AC" />
        <SolidColorBrush x:Key="AccentBrush" Color="#FFCA3A" />
        <SolidColorBrush x:Key="CyanBrush" Color="#23D5D5" />
        <LinearGradientBrush x:Key="WindowBackground" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#0A1020" Offset="0"/><GradientStop Color="#111C35" Offset="0.55"/><GradientStop Color="#281A3C" Offset="1"/></LinearGradientBrush>
        <DropShadowEffect x:Key="PanelShadow" Color="#000000" BlurRadius="18" ShadowDepth="8" Opacity="0.45" />
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="#AAB4CA" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter /></Border></ControlTemplate></Setter.Value></Setter>
            <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="#FFFFFF" /><Setter Property="Background" Value="#202B45" /></Trigger></Style.Triggers>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource NavButton}">
            <Setter Property="Background" Value="#FFCA3A" /><Setter Property="Foreground" Value="#15121A" /><Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Padding" Value="24,14" />
            <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#FFE37A" /></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35" /></Trigger></Style.Triggers>
        </Style>
        <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource NavButton}"><Setter Property="BorderBrush" Value="#35415D" /><Setter Property="BorderThickness" Value="1" /></Style>
        <Style x:Key="HudLabel" TargetType="TextBlock"><Setter Property="Foreground" Value="#8994AC" /><Setter Property="FontSize" Value="11" /><Setter Property="FontWeight" Value="Bold" /></Style>
        <Style TargetType="ProgressBar"><Setter Property="Foreground" Value="#23D5D5" /><Setter Property="Background" Value="#0B1224" /><Setter Property="BorderBrush" Value="#385273" /><Setter Property="BorderThickness" Value="1" /><Setter Property="Height" Value="10" /></Style>
    </Window.Resources>
    <Grid Background="{StaticResource WindowBackground}">
        <Grid.RowDefinitions><RowDefinition Height="72" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#10182D" BorderBrush="#385273" BorderThickness="0,0,0,1" Effect="{StaticResource PanelShadow}">
            <Grid Margin="28,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="PIXEL" FontSize="24" FontWeight="Bold" Foreground="#FFCA3A" />
                    <TextBlock Text=" AUTO RACE" FontSize="24" FontWeight="Bold" Foreground="#F7F4EA" />
                    <Border Margin="16,0,0,0" Padding="8,4" Background="#E84855"><TextBlock Text="BETA" FontSize="10" FontWeight="Bold" /></Border>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="PORTFEL  " Foreground="#8994AC" VerticalAlignment="Center" />
                    <TextBlock x:Name="MoneyText" Text="$ 1 250" Foreground="#FFCA3A" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" />
                    <Button Style="{StaticResource NavButton}" Content="⌂  MENU" Click="Home_Click" Margin="26,0,0,0" />
                    <Button Style="{StaticResource NavButton}" Content="GARAŻ" Click="Garage_Click" Margin="26,0,0,0" />
                    <Button Style="{StaticResource NavButton}" Content="INSTRUKCJA" Click="Instructions_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" x:Name="MenuView" Margin="52,38">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.05*" /><ColumnDefinition Width="1*" /></Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,60,0">
                <TextBlock Text="SEZON 01 / START" Foreground="#23D5D5" FontSize="13" FontWeight="Bold" />
                <TextBlock Text="ZOSTAW ŚLAD." FontSize="56" FontWeight="Bold" Margin="0,14,0,0" />
                <TextBlock Text="Poczuj asfalt, zbierz Nitro i wyprzedź całą linię. Twoja historia zaczyna się na mokrych ulicach Neon City." TextWrapping="Wrap" Foreground="#AAB4CA" FontSize="17" LineHeight="28" Margin="0,18,0,0" MaxWidth="570" />
                <StackPanel Orientation="Horizontal" Margin="0,34,0,0"><Button Style="{StaticResource PrimaryButton}" Content="▶  SZYBKI WYŚCIG" Click="QuickRace_Click" /><Button Style="{StaticResource GhostButton}" Content="GARAŻ" Click="Garage_Click" Margin="14,0,0,0" /></StackPanel>
                <TextBlock Text="WASD / STRZAŁKI  •  SPACJA: NITRO  •  P: PAUZA" Foreground="#66738F" FontSize="11" Margin="2,24,0,0" />
            </StackPanel>
            <Border Grid.Column="1" Background="#141D34" BorderBrush="#426184" BorderThickness="1" Padding="24" VerticalAlignment="Center" Effect="{StaticResource PanelShadow}">
                <Grid Height="370">
                    <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="58" /></Grid.RowDefinitions>
                    <Canvas x:Name="HeroCanvas" ClipToBounds="True" Background="#182742">
                        <Rectangle Width="700" Height="170" Fill="#233A62" Canvas.Top="0" />
                        <Polygon Points="0,170 150,120 310,168 480,112 700,160 700,370 0,370" Fill="#1C2A43" />
                        <Polygon Points="0,234 170,174 360,230 535,165 700,215 700,370 0,370" Fill="#253753" />
                        <Rectangle Width="700" Height="100" Fill="#252A38" Canvas.Top="270" />
                        <Rectangle Width="700" Height="4" Fill="#FFCA3A" Canvas.Top="270" Opacity="0.6" />
                        <Rectangle Width="700" Height="3" Fill="#53617A" Canvas.Top="320" />
                        <Rectangle Width="50" Height="5" Fill="#E8E0C8" Canvas.Left="80" Canvas.Top="318" /><Rectangle Width="50" Height="5" Fill="#E8E0C8" Canvas.Left="210" Canvas.Top="318" /><Rectangle Width="50" Height="5" Fill="#E8E0C8" Canvas.Left="340" Canvas.Top="318" /><Rectangle Width="50" Height="5" Fill="#E8E0C8" Canvas.Left="470" Canvas.Top="318" />
                        <Border Background="#FF6B35" Width="116" Height="38" Canvas.Left="282" Canvas.Top="228"><TextBlock Text="COMET 86" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Foreground="#171526" /></Border>
                        <Rectangle Width="80" Height="10" Fill="#23D5D5" Canvas.Left="315" Canvas.Top="266" /><Rectangle Width="18" Height="18" Fill="#101522" Canvas.Left="300" Canvas.Top="253" /><Rectangle Width="18" Height="18" Fill="#101522" Canvas.Left="362" Canvas.Top="253" />
                        <TextBlock Text="NIGHT RUNNER" Foreground="#FFFFFF" FontSize="26" FontWeight="Bold" Canvas.Left="20" Canvas.Top="24" Opacity="0.12" />
                    </Canvas>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="NAJLEPSZY CZAS" Foreground="#8994AC" /><TextBlock Text="  01:42.80" Foreground="#FFCA3A" FontSize="18" FontWeight="Bold" Margin="12,0,0,0" /><TextBlock Text="  /  NOCNE MIASTO" Foreground="#8994AC" Margin="18,0,0,0" /></StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="1" x:Name="GarageView" Margin="52,32" Visibility="Collapsed">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.4*" /><ColumnDefinition Width="1*" /></Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,24,0"><TextBlock Text="GARAŻ / KOLEKCJA" Foreground="#23D5D5" FontSize="13" FontWeight="Bold" /><TextBlock Text="TWOJA FLOTA" FontSize="34" FontWeight="Bold" Margin="0,8,0,4" /><TextBlock Text="Kliknij samochód, aby obejrzeć go przed zakupem." Foreground="#8994AC" Margin="0,0,0,18"/><ScrollViewer VerticalScrollBarVisibility="Auto"><WrapPanel x:Name="CarList" /></ScrollViewer></StackPanel>
            <Border Grid.Column="1" Background="#141D34" BorderBrush="#2D3B5D" BorderThickness="1" Padding="28"><StackPanel><TextBlock Text="PODGLĄD POJAZDU" Foreground="#8994AC" FontSize="12" /><TextBlock x:Name="GarageCarName" Text="COMET 86" FontSize="30" FontWeight="Bold" Margin="0,4,0,0" /><TextBlock x:Name="GarageCarClass" Text="HOT HATCH" Foreground="#FFCA3A" FontSize="12" FontWeight="Bold" Margin="0,4,0,0" /><Canvas x:Name="GarageCarCanvas" Height="150" Background="#1C2A43" Margin="0,20,0,20" /><TextBlock x:Name="GarageCarDescription" Foreground="#AAB4CA" TextWrapping="Wrap" Margin="0,0,0,20" /><TextBlock Text="STATYSTYKI BAZOWE" Foreground="#8994AC" FontSize="11" /><Grid Margin="0,10,0,0"><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions><TextBlock Text="PRĘDKOŚĆ"/><ProgressBar x:Name="SpeedBar" Grid.Row="0" Margin="104,3,0,0" Height="8" /><TextBlock Text="PRZYSPIESZENIE" Grid.Row="1"/><ProgressBar x:Name="AccelerationBar" Grid.Row="1" Margin="104,3,0,0" Height="8" /><TextBlock Text="ZWROTNOŚĆ" Grid.Row="2"/><ProgressBar x:Name="HandlingBar" Grid.Row="2" Margin="104,3,0,0" Height="8" /><TextBlock Text="NITRO" Grid.Row="3"/><ProgressBar x:Name="NitroBar" Grid.Row="3" Margin="104,3,0,0" Height="8" /></Grid><Button x:Name="BuyCarButton" Style="{StaticResource PrimaryButton}" Content="KUP SAMOCHÓD" Click="BuyCar_Click" Margin="0,20,0,0" /><Button x:Name="UpgradeButton" Style="{StaticResource GhostButton}" Content="ULEPSZ SILNIK  •  $ 650" Click="UpgradeEngine_Click" Margin="0,8,0,0" /><StackPanel Orientation="Horizontal" Margin="0,10,0,0"><Button Content="TURBO" Tag="TurboLevels" Style="{StaticResource GhostButton}" Click="UpgradePart_Click"/><Button Content="OPONY" Tag="TireLevels" Style="{StaticResource GhostButton}" Click="UpgradePart_Click" Margin="6,0"/><Button Content="NITRO" Tag="NitroLevels" Style="{StaticResource GhostButton}" Click="UpgradePart_Click"/></StackPanel><TextBlock Text="LAKIER / PALETA RETRO" Foreground="#8994AC" FontSize="11" Margin="0,16,0,6"/><StackPanel Orientation="Horizontal"><Button Tag="#FF6B35" Background="#FF6B35" Width="28" Height="28" Click="Paint_Click"/><Button Tag="#23D5D5" Background="#23D5D5" Width="28" Height="28" Margin="8,0" Click="Paint_Click"/><Button Tag="#C77DFF" Background="#C77DFF" Width="28" Height="28" Click="Paint_Click"/><Button Tag="#F9C74F" Background="#F9C74F" Width="28" Height="28" Margin="8,0" Click="Paint_Click"/></StackPanel></StackPanel></Border>
        </Grid>

        <Grid Grid.Row="1" x:Name="RaceSetupView" Margin="52,32" Visibility="Collapsed"><Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions><StackPanel Grid.Column="0" Margin="0,0,38,0"><TextBlock Text="CENTRUM WYŚCIGÓW" Foreground="#23D5D5" FontSize="13" FontWeight="Bold"/><TextBlock Text="SZYBKI WYŚCIG" FontSize="38" FontWeight="Bold" Margin="0,8,0,24"/><TextBlock Text="TRASA" Foreground="#8994AC" FontSize="12"/><ComboBox x:Name="TrackCombo" SelectionChanged="TrackCombo_SelectionChanged" Margin="0,8,0,22" Height="42" FontSize="15"/><TextBlock Text="TRUDNOŚĆ" Foreground="#8994AC" FontSize="12"/><StackPanel Orientation="Horizontal" Margin="0,8,0,22"><Button x:Name="EasyButton" Content="ŁATWY" Style="{StaticResource GhostButton}" Click="Difficulty_Click"/><Button x:Name="NormalButton" Content="NORMALNY" Style="{StaticResource GhostButton}" Click="Difficulty_Click" Margin="8,0"/><Button x:Name="HardButton" Content="TRUDNY" Style="{StaticResource GhostButton}" Click="Difficulty_Click"/></StackPanel><TextBlock Text="PRZECIWNICY" Foreground="#8994AC" FontSize="12"/><Slider x:Name="OpponentsSlider" Minimum="1" Maximum="5" Value="3" TickFrequency="1" IsSnapToTickEnabled="True"/><TextBlock x:Name="OpponentsText" Text="3 rywali" Foreground="#FFCA3A" FontWeight="Bold"/><Button Style="{StaticResource PrimaryButton}" Content="▶  START WYŚCIGU" Click="StartRace_Click" Margin="0,32,0,0" HorizontalAlignment="Left"/></StackPanel><Border Grid.Column="1" Background="#141D34" Padding="28" BorderBrush="#2D3B5D" BorderThickness="1"><StackPanel><TextBlock Text="GOTOWY DO STARTU?" FontSize="22" FontWeight="Bold"/><TextBlock Text="Twój samochód" Foreground="#8994AC" Margin="0,18,0,0"/><TextBlock x:Name="SetupCarText" Text="COMET 86" FontSize="20" Foreground="#FFCA3A" FontWeight="Bold"/><TextBlock Text="NAGRODY" Foreground="#8994AC" Margin="0,26,0,6"/><TextBlock Text="1. miejsce     $ 1 200" FontSize="16"/><TextBlock Text="2. miejsce     $ 750" FontSize="16"/><TextBlock Text="3. miejsce     $ 450" FontSize="16"/><Border Background="#202B45" Padding="14" Margin="0,26,0,0"><TextBlock Text="Zbieraj bonusy na trasie. Nitro daje chwilową przewagę, osłona chroni przed jedną kolizją." TextWrapping="Wrap" Foreground="#AAB4CA"/></Border></StackPanel></Border></Grid>

        <Grid Grid.Row="1" x:Name="RaceView" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="60"/><RowDefinition Height="*"/><RowDefinition Height="82"/></Grid.RowDefinitions><Grid Margin="32,0"><TextBlock x:Name="RaceTrackTitle" Text="NOCNE MIASTO" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/><StackPanel HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="POZYCJA " Style="{StaticResource HudLabel}" VerticalAlignment="Center"/><TextBlock x:Name="PositionText" Text="1 / 4" Foreground="#FFCA3A" FontSize="20" FontWeight="Bold" Margin="6,0,0,0"/><Border Background="#182742" BorderBrush="#FFCA3A" BorderThickness="1" Padding="14,6" Margin="28,0,0,0"><StackPanel Orientation="Horizontal"><TextBlock Text="CZAS  " Style="{StaticResource HudLabel}" VerticalAlignment="Center"/><TextBlock x:Name="RaceTimeText" Text="00:00.00" Foreground="#FFFFFF" FontSize="20" FontWeight="Bold"/></StackPanel></Border></StackPanel></Grid><Grid Grid.Row="1" Margin="32,0"><Border BorderBrush="#2D3B5D" BorderThickness="1" ClipToBounds="True"><Canvas x:Name="RaceCanvas" Background="#19253B" ClipToBounds="True"/></Border><Grid x:Name="StartOverlay" Background="#0B1020AA"><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="PRZYGOTUJ SIĘ" Foreground="#23D5D5" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock x:Name="StartCountdownText" Text="3" Foreground="#FFCA3A" FontSize="92" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,4,0,0"/><TextBlock Text="STARTER NA POZYCJI" Foreground="#AAB4CA" FontSize="11" HorizontalAlignment="Center"/></StackPanel></Grid></Grid><Border Grid.Row="2" Background="#0F172A" BorderBrush="#25314B" BorderThickness="0,1,0,0"><Grid Margin="32,0"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="NITRO" Style="{StaticResource HudLabel}" VerticalAlignment="Center"/><ProgressBar x:Name="NitroRaceBar" Width="150" Height="12" Margin="12,0,24,0"/><TextBlock Text="PRĘDKOŚĆ" Style="{StaticResource HudLabel}" VerticalAlignment="Center"/><ProgressBar x:Name="SpeedometerBar" Maximum="220" Width="150" Height="12" Margin="12,0,10,0"/><TextBlock x:Name="SpeedText" Text="0 KM/H" Foreground="#FFCA3A" FontSize="16" FontWeight="Bold" Width="90" VerticalAlignment="Center"/><TextBlock Text="WASD / STRZAŁKI  •  SPACJA" Foreground="#66738F" VerticalAlignment="Center"/></StackPanel><Button Content="WYJŚCIE" Style="{StaticResource GhostButton}" HorizontalAlignment="Right" Click="ExitRace_Click"/></Grid></Border></Grid>

        <Grid Grid.Row="1" x:Name="InstructionsView" Margin="80,46" Visibility="Collapsed"><Grid.ColumnDefinitions><ColumnDefinition Width="1*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions><StackPanel Grid.Column="0" Margin="0,0,60,0"><TextBlock Text="POMOC / INSTRUKCJA" Foreground="#23D5D5" FontSize="13" FontWeight="Bold"/><TextBlock Text="ZASADY ULICY" FontSize="40" FontWeight="Bold" Margin="0,10,0,22"/><TextBlock Text="STEROWANIE" Foreground="#FFCA3A" FontWeight="Bold"/><TextBlock Text="↑ / W        przyspieszanie&#10;↓ / S        hamowanie&#10;← → / A D   zmiana pasa&#10;SPACJA       Nitro&#10;P              pauza" FontSize="16" LineHeight="30" Margin="0,12,0,30"/><TextBlock Text="MECHANIKA" Foreground="#FFCA3A" FontWeight="Bold"/><TextBlock Text="Wyprzedzaj rywali, omijaj plamy oleju i roboty drogowe. Zbieraj kapsuły Nitro, gotówkę oraz osłony. Kolizja spowalnia, ale osłona pochłonie pierwsze uderzenie." Foreground="#AAB4CA" TextWrapping="Wrap" FontSize="15" LineHeight="25"/></StackPanel><Border Grid.Column="1" Background="#141D34" Padding="30" BorderBrush="#2D3B5D" BorderThickness="1"><StackPanel><TextBlock Text="NAGRODY I POSTĘP" FontSize="22" FontWeight="Bold"/><TextBlock Text="Każdy wyścig zasila Twój portfel. Za miejsce na podium dostajesz najwięcej gotówki, a ukończenie trasy zapisuje najlepszy czas." Foreground="#AAB4CA" TextWrapping="Wrap" Margin="0,16,0,28" LineHeight="24"/><TextBlock Text="1. MIEJSCE     $ 1 200" Foreground="#FFCA3A" FontWeight="Bold" Margin="0,8"/><TextBlock Text="2. MIEJSCE     $ 750" Margin="0,8"/><TextBlock Text="3. MIEJSCE     $ 450" Margin="0,8"/><TextBlock Text="POZOSTAŁE      $ 200" Foreground="#8994AC" Margin="0,8"/><Border Background="#202B45" Padding="16" Margin="0,28,0,0"><TextBlock Text="W garażu kupisz auta, kolory i ulepszenia silnika, turbiny, opon oraz Nitro. Zapis jest automatyczny." TextWrapping="Wrap" Foreground="#AAB4CA"/></Border></StackPanel></Border></Grid>

        <Grid x:Name="PauseOverlay" Grid.Row="1" Background="#0B1020CC" Visibility="Collapsed"><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="PAUZA" FontSize="42" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock Text="Naciśnij P, aby wrócić na trasę" Foreground="#AAB4CA" Margin="0,10,0,0"/></StackPanel></Grid>
    </Grid>
</Window>
